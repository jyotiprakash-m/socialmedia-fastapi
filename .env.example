# PostgreSQL Database Connection URL (e.g. Neon, AWS RDS, Supabase, local PostgreSQL)
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require"

# Hasura GraphQL Endpoint for Python Backend Client (ariadne-codegen)
HASURA_GRAPHQL_URL="https://<your-hasura-app>.hasura.app/v1/graphql"
HASURA_ADMIN_SECRET="your-hasura-admin-secret"

# Hasura CLI Configuration (used automatically by hasura CLI commands)
HASURA_GRAPHQL_ENDPOINT="https://<your-hasura-app>.hasura.app"
HASURA_GRAPHQL_ADMIN_SECRET="your-hasura-admin-secret"

# Shared Secret for authenticating Hasura Webhooks (Event Triggers, Cron Triggers, Scheduled Events)
WEBHOOK_SECRET="super-secret-hasura-key"
